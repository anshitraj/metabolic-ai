# Metabolic AI — copy to .env.local for development. Never commit real values.
# Everything here is server-only (no NEXT_PUBLIC_ prefix) unless noted.

# --- Database ---
# PostgreSQL connection string. Leave unset in development to use an embedded
# PGlite database in .data/pglite (created and migrated automatically).
# DATABASE_URL=postgres://user:pass@localhost:5432/metabolic
# PGLITE_DIR=.data/pglite        # or "memory" for a throwaway DB

PUBLIC_WEB_URL=http://localhost:3000

# --- NEAR ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_EXPLORER_URL=https://testnet.nearblocks.io
# The metabolic contract (contracts/metabolic). Enables deposit() + on-chain receipts.
# NEAR_CONTRACT_ID=metabolic.your-account.testnet
# Without a contract, deposits can be plain transfers to this account (no receipts).
# NEAR_TREASURY_ACCOUNT_ID=your-treasury.testnet
# Account + function-call key allowed to call commit_receipt on the contract.
# NEAR_RECEIPT_SIGNER_ID=metabolic.your-account.testnet
# NEAR_RECEIPT_SIGNER_KEY=ed25519:...
# NEAR accounts whose deposits count as operating capital and who can edit policy / pause.
# OPERATOR_ACCOUNT_IDS=you.testnet

# NEAR/USD price feed (JSON shaped like CoinGecko simple/price). Stale after PRICE_MAX_AGE_S.
# PRICE_FEED_URL=https://api.coingecko.com/api/v3/simple/price?ids=near&vs_currencies=usd
# PRICE_MAX_AGE_S=300

# --- AI providers (set at least one) ---
# Model ids and prices live in config/models.json.
# One GEMINI_API_KEY enables every Gemini model in that catalog.
# GEMINI_MODELS from the legacy gateway is not used by this app.
# Restart the server after changing provider keys. Operators can send a small
# test prompt from Console > AI models to distinguish key, model and quota errors.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# NEAR AI Cloud: open models running in attested secure enclaves (private inference).
# Create a key at https://cloud.near.ai. Models and prices are in config/models.json.
# NEARAI_API_KEY=
# NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# OpenAI-compatible providers need their prices set here (USD per 1M tokens) to be enabled.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_COST_IN_PER_M=
# DEEPSEEK_COST_OUT_PER_M=
# LLAMA_API_KEY=
# LLAMA_BASE_URL=
# LLAMA_MODEL=
# LLAMA_COST_IN_PER_M=
# LLAMA_COST_OUT_PER_M=

# --- NEAR Intents: pay with any token (MAINNET, real funds; see docs/16) ---
# Off until a mainnet recipient is set. NEAR Intents has no testnet.
# INTENTS_RECIPIENT_ACCOUNT_ID=your-business.near
# Partner JWT from https://partners.near-intents.org (without it 1Click adds 0.25%).
# ONECLICK_JWT=
# INTENTS_SLIPPAGE_BP=100
# INTENTS_MIN_USD_MICRO=1000000
# INTENTS_MAX_USD_MICRO=500000000
# INTENTS_DEADLINE_MIN=60

# --- Economics ---
# Fixed hourly overhead counted toward burn (micro-USD; 1000000 = $1).
# OVERHEAD_PER_HOUR_MICRO=0
# RECEIPT_INTERVAL_MIN=10
# SESSION_TTL_HOURS=72

# --- Legal pages (optional) ---
# LEGAL_ENTITY_NAME=  LEGAL_ADDRESS=  SUPPORT_EMAIL=  LEGAL_JURISDICTION=
