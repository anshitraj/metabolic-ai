{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-testnet-demo/types/**/*.ts",
    ".next-testnet-demo/dev/types/**/*.ts",
    ".next-motion-dev/types/**/*.ts",
    ".next-motion-dev/dev/types/**/*.ts",
    ".next-motion-production/types/**/*.ts",
    ".next-motion-production/dev/types/**/*.ts",
    ".next-motion-final/types/**/*.ts",
    ".next-motion-final/dev/types/**/*.ts",
    ".next-motion-release/types/**/*.ts",
    ".next-motion-release/dev/types/**/*.ts",
    ".next-stress-motion/types/**/*.ts",
    ".next-stress-motion/dev/types/**/*.ts",
    ".next-stress-motion-final/types/**/*.ts",
    ".next-stress-motion-final/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "contracts"
  ]
}
