# Runtime secrets: set these in the hosting provider, never in build arguments.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/metabolic
# For Supabase use Connect > Session pooler (5432) with sslmode=require.
DATABASE_POOL_MAX=5
PUBLIC_WEB_URL=https://YOUR-PRODUCTION-DOMAIN
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_EXPLORER_URL=https://testnet.nearblocks.io
NEAR_CONTRACT_ID=metabolic-d0e41b6dc5.testnet
NEAR_RECEIPT_SIGNER_ID=metabolic-d0e41b6dc5.testnet
NEAR_RECEIPT_SIGNER_KEY=
OPERATOR_ACCOUNT_IDS=solrishu.testnet
GEMINI_API_KEY=
WORKER_INLINE=true
RECEIPT_INTERVAL_MIN=10
# Keep one replica in this version: SSE, provider breakers and rate limiting are in-process.
# Optional, MAINNET: pay with any token through NEAR Intents (docs/16-NEAR-INTENTS.md).
# INTENTS_RECIPIENT_ACCOUNT_ID=your-business.near
# ONECLICK_JWT=
